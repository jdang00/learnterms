		"eval:questions": "bun scripts/ai-eval/run.ts",
		"posthog:ai": "bun scripts/posthog-ai-observability.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"eval:report": "bun scripts/ai-eval/report.ts",
		"verify": "bun run check && bun run lint && bun run test"
	},
