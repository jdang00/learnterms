{
	"redirects": [
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "www.learnterms.com"
				}
			],
			"destination": "https://learnterms.com/:path*",
			"permanent": true
		},
		{
			"source": "/docs",
			"has": [
				{
					"type": "host",
					"value": "learnterms.com"
				}
			],
			"destination": "https://docs.learnterms.com/docs",
			"permanent": true
		},
		{
			"source": "/docs/getting-started",
			"has": [
				{
					"type": "host",
					"value": "learnterms.com"
				}
			],
			"destination": "https://docs.learnterms.com/docs/quickstart",
			"permanent": true
		},
		{
			"source": "/docs/lt-models",
			"has": [
				{
					"type": "host",
					"value": "learnterms.com"
				}
			],
			"destination": "https://docs.learnterms.com/docs/ai/learnterms-models",
			"permanent": true
		},
		{
			"source": "/docs/:match*",
			"has": [
				{
					"type": "host",
					"value": "learnterms.com"
				}
			],
			"destination": "https://docs.learnterms.com/docs/:match*",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "app.learnterms.com"
				}
			],
			"destination": "/dashboard/:path*"
		},
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "admin.learnterms.com"
				}
			],
			"destination": "/admin/:path*"
		}
	],
	"installCommand": "bun install --frozen-lockfile",
	"buildCommand": "bunx convex deploy --cmd 'bun run build' --cmd-url-env-var-name PUBLIC_CONVEX_URL",
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=63072000"
				}
			]
		}
	]
}
